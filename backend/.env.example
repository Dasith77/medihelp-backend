# =============================================================================
# MediHelp Dispensary API - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/medihelp_db
DATABASE_URL=postgresql://user:password@localhost:5432/medihelp_db

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens
# IMPORTANT: Generate a strong random key for production
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# JWT signing algorithm (recommended: HS256)
ALGORITHM=HS256

# Token expiration time in minutes
# Default: 30 minutes, adjust based on security requirements
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP)
# -----------------------------------------------------------------------------
# SMTP server settings for sending booking confirmation emails
# For Gmail: Use smtp.gmail.com with an App Password
# https://support.google.com/accounts/answer/185833

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP authentication username (usually your email)
SMTP_USER=your-email@gmail.com

# SMTP authentication password
# For Gmail: Use App Password, not your regular password
SMTP_PASSWORD=your-app-password

# Sender email address (appears in "From" field)
SMTP_FROM=noreply@medihelp.com

# -----------------------------------------------------------------------------
# FRONTEND URLs
# -----------------------------------------------------------------------------
# URLs for the frontend applications
# Used for generating links in emails and CORS configuration

# Patient-facing web application URL
# Used in booking confirmation emails for tracking links
PATIENT_WEB_URL=http://localhost:3000

# Admin dashboard URL
ADMIN_WEB_URL=http://localhost:3001

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# [ ] DATABASE_URL points to production database
# [ ] SECRET_KEY is a strong, unique random value
# [ ] SMTP credentials are configured for production email service
# [ ] Frontend URLs are updated to production domains
# [ ] This file is NOT committed to version control
# =============================================================================
